# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.
# Values marked CHANGE-ME must be replaced before any non-local deployment;
# the API refuses to boot in production on the development defaults.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database -------------------------------------------------------------
# Postgres 16 WITH the pgvector and pg_trgm extensions (docker-compose.yml
# uses pgvector/pgvector:pg16). connection_limit/pool_timeout: Prisma's
# default pool is derived from CPU count, which can be as low as 3 on a small
# VM, too few for several simultaneous checkouts.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roya?schema=public&connection_limit=10&pool_timeout=20&connect_timeout=10"

# --- Redis (rate limiting) -------------------------------------------------
# A dedicated instance: throttler counters and the per-account sign-in bucket.
# Name the instance only, with no /db number. With it down, sign-in answers
# 503 (deliberately never "unlimited") and the rest of the API keeps serving.
REDIS_URL="redis://localhost:6379"

# --- API ------------------------------------------------------------------
API_PORT=3001
API_PREFIX=api
# The storefront origin(s) allowed to call the API from a browser.
CORS_ORIGINS="http://localhost:3000"

# --- Auth -----------------------------------------------------------------
# CHANGE-ME. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production-0000000000"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production-000000000"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# CHANGE-ME. Exactly 32 bytes. Generate with: openssl rand -base64 24 | head -c 32
APP_ENCRYPTION_KEY="dev-app-encryption-key-32-bytes0"

# --- Topology -------------------------------------------------------------
# STANDALONE: one node, one database, no replication. ROYA is one atelier.
NODE_ROLE=STANDALONE
NODE_ID=main

# --- Modules --------------------------------------------------------------
# Which optional modules this deployment switches on. Always-on modules
# (settings, users, addresses, custom-fields, ...) ignore this list.
# Shipped in this repository (physically present): see apps/api/src/modules.
# The atelier's own: purchasing, production, bom (what is made, from what, bought from whom),
# finance, analytics, reports (what it costs and earns) and support (client tickets).
# Shipped but OFF by default: accounting (turn on once ROYA wants a real
# general ledger; its DB-level immutability triggers are already migrated).
# The back office's Profit & loss, Cash flow and Fiscal periods read that
# ledger and stay hidden until it is on.
MODULES="catalog,content,collections,search,measurements,cart,stitching,inventory,parties,payments,orders,crm,marketing,tax,receivables,pricing,fulfilment,notify,promotions,giftcards,wishlist,commission,notification-preferences,tracking,purchasing,production,bom,analytics,reports,finance,support"

# --- Payments -------------------------------------------------------------
# Comma-separated allowlist of enabled payment providers.
# Present in this repository: cod, bank_transfer, account, and three Pakistani
# gateways (jazzcash, easypaisa, giftkarta) that do not apply to a UAE shop
# and must stay OFF. There is NO card / Apple Pay provider yet: ROYA's choice
# of UAE payment gateway is an open decision (docs/OPEN-QUESTIONS.md). Until a
# provider is added, only bank transfer can settle an order.
PAYMENT_PROVIDERS="bank_transfer"
COURIER_PROVIDERS="manual"

# --- Storage (S3-compatible; MinIO locally) -------------------------------
STORAGE_DRIVER=local
S3_ENDPOINT="http://localhost:9000"
S3_REGION=us-east-1
S3_BUCKET=roya
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL="http://localhost:9000/roya"
LOCAL_STORAGE_DIR="./uploads"
LOCAL_STORAGE_PUBLIC_URL="http://localhost:3001/api/v1/files"

# --- Notifications --------------------------------------------------------
# Channels: log (dev), email, whatsapp, sms. Leave as "log" in development:
# every message the shop would send is printed to the API log instead.
NOTIFICATION_CHANNELS="log"

# --- Email ----------------------------------------------------------------
# Adding "email" above without an SMTP_HOST stops the API booting, rather than
# silently dropping order confirmations.
SMTP_HOST=
SMTP_PORT=587
# true only for implicit TLS on port 465; 587 upgrades via STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# CHANGE-ME: the sending domain is not decided yet (docs/OPEN-QUESTIONS.md).
MAIL_FROM="ROYA <no-reply@roya.example>"
MAIL_REPLY_TO="atelier@roya.example"

# --- WhatsApp / SMS -------------------------------------------------------
# The designer replies on WhatsApp, so this channel matters to ROYA. A generic
# gateway contract (POSTs {from, to, message} as JSON, bearer token). Adding
# "whatsapp"/"sms" to NOTIFICATION_CHANNELS without these stops the API booting.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_NUMBER=
# Verifies inbound WhatsApp webhooks. Without it every inbound message is
# rejected unverified, never waved through.
WHATSAPP_WEBHOOK_SECRET=
SMS_API_URL=
SMS_API_TOKEN=
SMS_FROM_NUMBER=

# --- Store ----------------------------------------------------------------
# These two are shown to customers; the brand's own identity lives in
# packages/shared/src/brand.ts (Law 1), not here.
STORE_NAME="ROYA"
# Builds the "View your order" links. Must be the public storefront origin.
STOREFRONT_URL="http://localhost:3000"
# Shown in bank-transfer emails so the customer knows where to send proof.
SUPPORT_WHATSAPP=
# Free text, newline-separated: printed as-is in the bank transfer panel.
BANK_TRANSFER_DETAILS=

# --- Seed admin (development only) ---------------------------------------
SEED_ADMIN_EMAIL="admin@roya.example"
SEED_ADMIN_PASSWORD="admin12345"

# --- Storefront (apps/storefront) -------------------------------------------
# The browser calls the storefront's own /api/v1, which Next rewrites to the API:
# one origin, so the cart and sign-in cookies are first-party and no CORS list has
# to be kept in step. Only the server side needs to know where the API really is.
NEXT_PUBLIC_API_URL="/api/v1"
# Where the Next server reaches the API (the container network in production).
API_INTERNAL_URL="http://localhost:3001/api/v1"
# On Vercel the storefront finds the API through a service binding (root vercel.json),
# which injects API_SERVICE_URL itself at run time. Never set it by hand; API_INTERNAL_URL,
# when set, takes precedence over it.
# The public origin: canonical URLs, Open Graph, the sitemap. Must equal STOREFRONT_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
