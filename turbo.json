{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "APP_ENCRYPTION_KEY",
    "PAYMENT_PROVIDERS",
    "MODULES",
    "STORAGE_DRIVER",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_PUBLIC_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SITE_URL"
  ],
  "tasks": {
    // The Prisma client is generated code and git-ignored (apps/api/src/generated), so a fresh
    // checkout has none, and every task below that compiles the API needs it first. Only
    // @newax/api defines this script; turbo skips a dependency a package does not have.
    // Without it a clean builder (Cloudflare's, a new CI) fails with
    // "Property 'notificationPreference' does not exist on type 'PrismaService'".
    "db:generate": {
      "inputs": ["prisma/**", "prisma.config.ts", "package.json"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["coverage/**"]
    },
    "db:seed": {
      // The seed imports @newax/shared, which resolves to its build output,
      // so the package has to be built first.
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    }
  }
}
